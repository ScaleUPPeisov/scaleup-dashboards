  const [quotaRevision,setQuotaRevision]=useState(0),[quotaClock,setQuotaClock]=useState(()=>youtubeQuotaClockSnapshot());
  useEffect(()=>{const off=subscribeYoutubeQuota(()=>setQuotaRevision(x=>x+1)),offClock=subscribeYoutubeQuotaClock(setQuotaClock);return()=>{off();offClock()}},[]);
  useEffect(()=>{if(!channels.length)return;if(!channels.some(c=>c.id===channelId)){const saved=loadActivePublishChannel(),next=channels.some(c=>c.id===saved)?saved:channels[0].id;if(next){saveActivePublishChannel(next);setChannelId(next)}return}if(loadActivePublishChannel()!==channelId)saveActivePublishChannel(channelId)},[channelId,channels.map(c=>c.id).join('|')]);
