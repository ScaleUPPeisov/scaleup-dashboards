- function clearCurrentDraft(){if(!channelId)return;suppressAutosave.current=true;clearMetadataDraft(channelId);setPaste('');setRows([]);setDocxStrict(false);setYt(x=>x.map(v=>({...v,selected:false})));setDraftSavedAt('');setSyncStatus('Черновик очищен');queueMicrotask(()=>{suppressAutosave.current=false})}
