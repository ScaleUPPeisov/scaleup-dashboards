   {target==='youtube'&&selectedYt.length>0&&<section className={`panel metadataQuotaPreflight ${metadataQuotaPlan.affordable?'ready':'blocked'}`}><div className="panelHead"><div><small>YOUTUBE API — РАСЧЁТ ОПЕРАЦИИ</small><h3>{metadataQuotaPlan.affordable?'✓ QUOTA ДОСТАТОЧНО':'✕ НЕДОСТАТОЧНО QUOTA'}</h3><p>Локальный request plan. До нажатия «Применить» YouTube API requests: 0.</p></div><span>{selectedYt.length} видео</span></div><div className="quotaOperationNumbers"><span><small>Сейчас доступно</small><b>{metadataGeneral.available.toLocaleString('ru-RU')}</b></span><span><small>Эта операция потратит</small><b>−{metadataGeneral.required.toLocaleString('ru-RU')}</b></span><span><small>После операции останется</small><b>{metadataGeneral.remainingAfter.toLocaleString('ru-RU')}</b></span><span><small>Планируемых API calls</small><b>{metadataPlannedCalls}</b></span><span><small>Сброс quota</small><b>{quotaClock.localTime}</b></span><span><small>До сброса</small><b className="mono">{quotaClock.countdown}</b></span></div><details><summary>Показать расчёт</summary>{metadataQuotaPlan.operations.map((x,i)=><p key={i}>{x.count} × {x.method} × {x.unitCost} = {x.cost} units • {x.label}</p>)}<p className="quotaContingency">План включает backup, pre-read, один videos.update и обязательный post-update videos.list. Скрытых fallback/retry запросов внутри Apply нет.</p></details></section>}
   {history.length>0&&<details className="panel metadataHistory"><summary>История операций • {channel?.name||channelId} • {history.length}</summary><div>{history.slice(0,20).map(h=><span key={h.operationId}><b>{new Date(h.at).toLocaleString('ru-RU')} • {h.channelName}</b><small>{h.selectedVideoCount} видео • изменено {h.changedVideoCount} • {h.changedFields.length?h.changedFields.join(' + '):'без фактических изменений'} • {h.status==='success'?'Успешно':h.status==='partial'?'Частично':'Ошибка'}{h.actualQuota!==undefined?` • Quota: ${h.actualQuota}${h.plannedQuota!==undefined?` / план ${h.plannedQuota}`:''}`:''}</small><small className="mono">{h.operationId}{h.backupPath?` • backup: ${h.backupPath}`:''}</small></span>)}</div></details>}
   {applyReport&&<section className="panel"><div className="panelHead"><div><small>YOUTUBE WRITE REPORT</small><h3>{applyReport.failed===0&&applyReport.issues.length===0?'✓ Запись подтверждена':'Результат применения'}</h3></div><button onClick={()=>setApplyReport(null)}>Закрыть</button></div><div className="syncAudit"><span>Метаданные <b>{applyReport.metadataOk}/{applyReport.total}</b></span>{applyReport.scheduleTotal>0&&<span>Расписание <b>{applyReport.scheduleOk}/{applyReport.scheduleTotal}</b></span>}<span>Полностью не записано <b>{applyReport.failed}</b></span>{applyReport.pausedByQuota&&<span className="warn">Пауза квоты • осталось <b>{applyReport.pending||0}</b></span>}</div>{applyReport.issues.length>0&&<div className="metadataPreviewList">{applyReport.issues.map((x,i)=><div className="metadataPreviewRow missing" key={`${x.videoId}-${i}`}><span><b>{x.phase==='schedule'?'РАСПИСАНИЕ':'МЕТАДАННЫЕ'} • {x.videoId}</b><small>{short(x.title,70)}</small></span><strong>{x.phase==='schedule'?'Метаданные сохранены, расписание не применено':'Видео не обновлено'}</strong><em>{x.error}</em></div>)}</div>}</section>}
   <input ref={file} hidden type="file" multiple accept=".docx,.json,.txt,.csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document" onChange={e=>{void readFiles(e.target.files);e.currentTarget.value=''}}/>
   <div className="metadataHubGrid">
-   <section className="panel metadataSourcePanel"><div className="panelHead"><div><small>01 • ИСТОЧНИК</small><h3>SEO pack</h3></div><button className="primary compactAction" onClick={()=>file.current?.click()}>Загрузить DOCX / файл</button></div><textarea className="metadataPaste" value={paste} onChange={e=>setPaste(e.target.value)} placeholder={'VIDEO 1\nTITLE\n...\nDESCRIPTION\n...\nTAGS\n...\nPUBLISH TIME\n04:00 KRAT\n\nVIDEO 2\n...'}/><div className="metadataPasteActions"><button disabled={!paste.trim()} onClick={parsePaste}>Разобрать текст GPT</button><button onClick={clearCurrentDraft}>Очистить</button><span>DOCX / JSON / TXT / CSV</span></div></section>
+   <section id="metadata-source" className="panel metadataSourcePanel"><div className="panelHead"><div><small>01 • ИСТОЧНИК</small><h3>SEO pack</h3></div><button className="primary compactAction" onClick={()=>file.current?.click()}>Загрузить DOCX / файл</button></div><textarea className="metadataPaste" value={paste} onChange={e=>setPaste(e.target.value)} placeholder={'VIDEO 1\nTITLE\n...\nDESCRIPTION\n...\nTAGS\n...\nPUBLISH TIME\n04:00 KRAT\n\nVIDEO 2\n...'}/><div className="metadataPasteActions"><button disabled={!paste.trim()} onClick={parsePaste}>Разобрать текст GPT</button><button onClick={clearCurrentDraft}>Очистить</button><span>DOCX / JSON / TXT / CSV</span></div></section>
