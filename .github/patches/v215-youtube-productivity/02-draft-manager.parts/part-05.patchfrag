    <section className="panel metadataTargetPanel"><div className="panelHead"><div><small>02 • НАЗНАЧЕНИЕ</small><h3>Куда применить</h3></div></div><label>Канал<select value={channelId} onChange={e=>switchMetadataChannel(e.target.value)}>{sortChannelsAlphabetically(channels).map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select></label><div className="metadataTargetSwitch"><button className={target==='future'?'active':''} onClick={()=>setTarget('future')}><b>Будущие VYRON YT PEISOV</b><small>проекты до загрузки</small></button><button className={target==='youtube'?'active':''} onClick={()=>setTarget('youtube')}><b>Уже на YouTube</b><small>выбранные private/scheduled</small></button></div>{target==='future'?<div className="metadataTargetInfo"><strong>{future.length}</strong><span>будущих проектов</span></div>:<><div className={`profileAutoBadge ${profileId?'good':'warn'}`}><small>OAuth</small><b>{profileId?'✓ привязан автоматически':'не подключён'}</b></div><div className="metadataYoutubeLoad"><label>Лимит<input type="number" min="1" max="5000" value={limit} onChange={e=>setLimit(+e.target.value||1000)}/></label><label>Порядок<select value={order} onChange={e=>setOrder(e.target.value as any)}><option value="newest">новые → старые</option><option value="oldest">старые → новые</option></select></label><button disabled={busy||!profileId} onClick={loadYoutube}>↻ Синхронизировать</button></div><div className="metadataTargetInfo"><strong>{selectedYt.length}</strong><span>выбрано из {yt.length}</span><small>{syncStatus||'YouTube будет загружен автоматически'}</small></div></>}</section>
   </div>
