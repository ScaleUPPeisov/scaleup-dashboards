 .youtubeChannelBar{display:grid;grid-template-columns:minmax(190px,.9fr) minmax(170px,.8fr) minmax(200px,.9fr) minmax(260px,1.3fr);gap:10px;align-items:end;margin:0 0 10px;padding:10px 12px;border:1px solid rgba(67,216,255,.15);border-radius:12px;background:rgba(8,27,40,.62)}.youtubeChannelBarTitle{display:flex;flex-direction:column;gap:2px}.youtubeChannelBarTitle small,.youtubeRecentChannels>small,.youtubeChannelSelect>span{font-size:8px;letter-spacing:.12em;color:#66869a}.youtubeChannelBarTitle b{font-size:13px}.youtubeChannelBarTitle span,.youtubeChannelFeedback{font-size:8px;color:#6f8da3}.youtubeChannelSearch{display:flex;align-items:center;gap:7px;padding:0 9px;height:34px;border:1px solid rgba(255,255,255,.08);border-radius:9px;background:rgba(255,255,255,.025)}.youtubeChannelSearch input{width:100%;border:0;outline:0;background:transparent;color:inherit}.youtubeChannelSelect{display:flex;flex-direction:column;gap:4px}.youtubeChannelSelect select{height:34px}.youtubeRecentChannels{display:flex;flex-direction:column;gap:4px;min-width:0}.youtubeRecentChannels>div{display:flex;gap:4px;overflow:auto}.youtubeRecentChannels button{white-space:nowrap;padding:6px 8px;border-radius:8px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.025);color:#9bb2c3;font-size:8px}.youtubeRecentChannels button.active{border-color:rgba(83,242,189,.25);color:#bfffe8}.youtubeRecentChannels span{font-size:8px;color:#5e778a}.youtubeChannelFeedback{grid-column:1/-1;min-height:10px;color:#71d9c1}.youtubeChannelContext{min-width:0}@media(max-width:1100px){.youtubeChannelBar{grid-template-columns:1fr 1fr}.youtubeChannelFeedback{grid-column:1/-1}}@media(max-width:760px){.youtubeChannelBar{grid-template-columns:1fr}}
+
+/* VYRON 2.1.5 — Metadata Draft Manager */
+.metadataDraftManager{display:grid;grid-template-columns:minmax(230px,1.3fr) auto auto;gap:12px;align-items:center;margin:0 0 10px;padding:10px 12px;border:1px solid rgba(91,220,196,.16);border-radius:10px;background:rgba(8,33,39,.38)}.metadataDraftManager>div:first-child{display:flex;flex-direction:column;gap:2px}.metadataDraftManager small{font-size:8px;color:#66869a}.metadataDraftManager b{font-size:10px}.metadataDraftManager.unsaved b{color:#ffc06b}.metadataDraftManager.restored b{color:#64dfff}.metadataDraftManager.completed b{color:#53f2bd}.metadataDraftFacts{display:flex;gap:6px}.metadataDraftFacts span{min-width:62px;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.03);display:flex;flex-direction:column}.metadataDraftActions{display:flex;gap:5px}.metadataDraftActions button{padding:7px 9px}.metadataDraftManager>strong{grid-column:1/-1;color:#ffc06b;font-size:8px}@media(max-width:900px){.metadataDraftManager{grid-template-columns:1fr}.metadataDraftFacts,.metadataDraftActions{justify-content:flex-start}}
-- 
2.47.3

