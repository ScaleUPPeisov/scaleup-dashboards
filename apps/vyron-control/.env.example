# Server-only secrets. Never commit real values.
VYRON_CONTROL_TOKEN=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
VYRON_YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# Channel IDs in channels.json, each as {"id":"UC...","name":"..."}
VYRON_CHANNELS_FILE=./channels.json

# Local tracking budget ONLY; Google Cloud project-wide consumption is NOT known.
VYRON_CONTROL_DAILY_BUDGET=200

# Bind to loopback by default; put HTTPS/Tailscale in front of this.
HOST=127.0.0.1
PORT=8787
