{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "vyron-control",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vyron-control",
    "database_id": "7e707d9f-5897-45ea-8f8f-1652b39e2148",
    "migrations_dir": "./migrations"
  }],
  "triggers": {
    "crons": ["0 0 * * *", "0 15 * * *", "5,10,15,20,25 0,15 * * *", "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"]
  },
  "vars": {
    "QUOTA_DAILY_BUDGET": "200"
  }
}
