{
  "name": "@vyron/control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "dependencies": {"@block65/webcrypto-web-push": "2.0.0"},
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test src/*.test.mjs cloudflare/tests/*.test.mjs agent/*.test.mjs",
    "agent:start": "node agent/run.mjs",
    "agent:install": "node agent/install.mjs",
    "push:keys": "node agent/generate-push-keys.mjs",
    "agent:uninstall": "node agent/uninstall.mjs",
    "cloud:dev": "npx wrangler dev -c cloudflare/wrangler.jsonc",
    "cloud:deploy": "npx wrangler deploy -c cloudflare/wrangler.jsonc"
  }
}
