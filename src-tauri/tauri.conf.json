{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelsFactory",
  "version": "0.2.2",
  "identifier": "com.scaleup.reelsfactory",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ReelsFactory",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "macOS": { "minimumSystemVersion": "13.0" },
    "externalBin": [
      "binaries/reelsfactory-video",
      "binaries/whisper-cli"
    ]
  }
}
