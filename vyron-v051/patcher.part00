from pathlib import Path
import json,re
root=Path('.vyron-v051')

def must_replace(path, old, new):
    p=root/path
    s=p.read_text()
    if old not in s:
        raise SystemExit(f'marker not found in {path}: {old[:120]!r}')
    p.write_text(s.replace(old,new,1))

def append_once(path, marker, text):
    p=root/path; s=p.read_text()
    if marker not in s: p.write_text(s+'\n'+text+'\n')

# versions
p=root/'package.json'; d=json.loads(p.read_text()); d['version']='0.5.1'; p.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
p=root/'src-tauri/tauri.conf.json'; d=json.loads(p.read_text()); d['version']='0.5.1'; p.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
for path in ['src-tauri/Cargo.toml']:
    p=root/path; s=p.read_text(); p.write_text(s.replace('version = "0.5.0"','version = "0.5.1"',1))
p=root/'package-lock.json'; d=json.loads(p.read_text()); d['version']='0.5.1';
if '' in d.get('packages',{}): d['packages']['']['version']='0.5.1'
p.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
p=root/'src-tauri/Cargo.lock'; s=p.read_text(); s,n=re.subn(r'(name = "channelflow"\nversion = ")0\.5\.0("\n)',r'\g<1>0.5.1\2',s,count=1); 
if n!=1: raise SystemExit('Cargo.lock app version marker missing')
p.write_text(s)

