|e|format!("YouTube videos: {e}"))?;let st=r.status();let v:Value=r.json().await.map_err(|e|e.to_string())?;if !st.is_success(){return Err(youtube_error(&v,"Не удалось получить данные видео"))}for item in v.get("items").and_then(|x|x.as_array()).cloned().unwrap_or_default(){if let Some(id)=item.get("id").and_then(|x|x.as_str()){by_id.insert(id.to_string(),item);}}}
 let mut out=Vec::new();for (position,id) in ids.iter().enumerate(){if let Some(item)=by_id.get(id){let sn=item.get("snippet").cloned().unwrap_or_else(||json!({}));let st=item.get("status").cloned().unwrap_or_else(||json!({}));out.push(json!({"id":id,"position":position,"title":sn.get("title").and_then(|x|x.as_str()).unwrap_or(""),"description":sn.get("description").and_then(|x|x.as_str()).unwrap_or(""),"tags":sn.get("tags").cloned().unwrap_or_else(||json!([])),"categoryId":sn.get("categoryId").and_then(|x|x.as_str()).unwrap_or("10"),"publishedAt":sn.get("publishedAt").and_then(|x|x.as_str()),"privacyStatus":st.get("privacyStatus").and_then(|x|x.as_str()).unwrap_or("unknown"),"publishAt":st.get("publishAt").and_then(|x|x.as_str()),"thumbnail":sn.pointer("/thumbnails/medium/url").and_then(|x|x.as_str()),"selected":true}));}}
 Ok(json!({"channelId":profile.channel_id,"channelTitle":profile.channel_title,"videos":out}))
}

#[tauri::command]
pub async fn youtube_update_existing_video(app:AppHandle,profile_id:String,video_id:String,title:String,description:String,tags:Vec<String>,publish_at:Option<String>)->Result<Value,String>{
 let (token,profile)=valid_access_token(&app,&profile_id).await?;if !profile.scopes.iter().any(|s|s=="https://www.googleapis.com/auth/youtube.force-ssl"||s=="https://www.googleapis.com/auth/youtube"){return Err("YouTube профиль подключён со старыми правами. Переподключи канал в VYRON 0.5.1.".into())}
 let client=reqwest::Client::new();let r=client.get("https://www.googleapis.com/youtube/v3/videos").bearer_auth(&token).query(&[("part","snippet,status"),("id",video_id.as_str())]).send().await.map_err(|e|format!("YouTube video read: {e}"))?;let st=r.status();let v:Value=r.json().await.map_err(|e|e.to_string())?;if !st.is_success(){return Err(youtube_error(&v,"Не удалось перечитать видео"))}let item=v.get("items").and_then(|x|x.as_array()).and_then(|a|a.first()).ok_or_else(||"Видео не найдено".to_string())?;let sn=item.get("snippet").cloned().unwrap_or_else(||json!({}));let old_status=item.get("status").cloned().unwrap_or_else(||json!({}));if profile.channel_id.as_deref()!=sn.get("channelId").and_then(|x|x.as_str()){return Err("Видео принадлежит другому каналу".into())}
 let category=sn.get("categoryId").and_then(|x|x.as_str()).unwrap_or("10");let mut body=json!({"id":video_id,"snippet":{"title":title.trim().chars().take(100).collect::<String>(),"description":description.chars().take(5000).collect::<String>(),"tags":tags.into_iter().take(30).collect::<Vec<_>>(),"categoryId":category}});let mut parts="snippet".to_string();if let Some(p)=publish_at.as_ref().filter(|x|!x.trim().is_empty()){if old_status.get("privacyStatus").and_then(|x|x.as_str())!="private"{return Err("Отложенную дату можно безопасно поставить только приватному видео, которое ещё не опубликовано.".into())}let mut ns=json!({"privacyStatus":"private","publishAt":p});for k in ["embeddable","license","publicStatsViewable","selfDeclaredMadeForKids","containsSyntheticMedia"]{if let Some(x)=old_status.get(k){ns[k]=x.clone();}}body["status"]=ns;parts="snippet,status".into();}
 let u=client.put("https://www.googleapis.com/youtube/v3/videos").bearer_auth(&token).query(&[("part",parts.as_str())]).json(&body).send().await.map_err(|e|format!("YouTube update: {e}"))?;let ust=u.status();let uv:Value=u.json().await.map_err(|e|e.to_string())?;if !ust.is_success(){return Err(youtube_error(&uv,"YouTube не принял изменения"))}Ok(json!({"id":video_id,"title":uv.pointer("/snippet/title"),"privacyStatus":uv.pointer("/status/privacyStatus"),"publishAt":uv.pointer("/status/publishAt")}))
}

'''
s=s.replace(marker,insert+marker,1); y.write_text(s)

# register commands
must_replace(Path('src-tauri/src/lib.rs'),
'youtube::youtube_channel_stats,youtube::youtube_oauth_profiles,youtube::youtube_oauth_connect,youtube::youtube_oauth_disconnect,youtube::youtube_upload_video,',
'youtube::youtube_channel_stats,youtube::youtube_oauth_profiles,youtube::youtube_oauth_connect,youtube::youtube_oauth_disconnect,youtube::youtube_upload_video,youtube::youtube_list_existing_videos,youtube::youtube_update_existing_video,')

# Existing Videos React screen
(root/'src/ExistingVideos.tsx').write_text(r'''import React,{useEffect,useRef,useState} from 'react';
import {api} from './api';import {useApp} from './store';import type {YoutubeExistingVideo,YoutubeProfile} from './types';import {parseMetadataFile,type ImportedMetadata} from './metadata';import {buildExistingSchedule,orderedExistingVideos,overlayExistingMetadata} from './youtubeExisting';
const local=(iso?:string)=>{if(!iso)return '';const d=new Date(iso);return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)};
export function ExistingVideos(){const channels=useApp(s=>s.channels),toast=useApp(s=>s.toast);const [profiles,setProfiles]=useState<YoutubeProfile[]>([]),[channelId,setChannelId]=useState(channels[0]?.id||''),[profileId,setProfileId]=useState(channels[0]?.youtubeProfileId||''),[videos,setVideos]=useState<YoutubeExistingVideo[]>([]),[busy,setBusy]=useState(false),[limit,setLimit]=useState(30),[order,setOrder]=useState<'oldest'|'newest'>('oldest'),[start,setStart]=useState(()=>{const d=new Date();d.setDate(d.getDate()+1);d.setHours(18,0,0,0);return local(d.toISOString())}),[cadence,setCadence]=useState(2),[meta,setMeta]=useState<ImportedMetadata[]>([]);const file=useRef<HTMLInputElement>(null);useEffect(()=>{api.youtubeProfiles().then(setProfiles).catch(()=>{})},[]);useEffect(()=>{const c=channels.find(x=>x.id===channelId);if(c){setProfileId(c.youtubeProfileId||'');setCadence(c.cadenceDays||2)}},[channelId]);async function sync(){if(!profileId){toast('Сначала привяжи YouTube OAuth к каналу');return}setBusy(true);try{const r=await api.youtubeListExisting(profileId,limit);setVideos((r.videos||[]).map((x:any)=>({...x,selected:true,applyState:'idle'})));toast(`Получено ${r.videos?.length||0} видео`)}catch(e){toast(String(e))}finally{setBusy(false)}}function schedule(){if(!start)return;setVideos(buildExistingSchedule(orderedExistingVideos(videos,order),new Date(start).toISOString(),cadence));}async function read(files:FileList|null){if(!files?.length)return;const rows:ImportedMetadata[]=[];for(const f of Array.from(files))rows.push(...parseMetadataFile(f.name,await f.text()));setMeta(rows);setVideos(v=>overlayExistingMetadata(orderedExistingVideos(v,order),rows));toast(`Метаданные: ${rows.length}`)}async function apply(){const selected=videos.filter(v=>v.selected);if(!selected.length)return;setBusy(true);let ok=0;try{for(const v of selected){setVideos(x=>x.map(z=>z.id===v.id?{...z,applyState:'saving',error:undefined}:z));try{await api.youtubeUpdateExisting(profileId,v.id,v.title,v.description,v.tags,v.publishAt);ok++;setVideos(x=>x.map(z=>z.id===v.id?{...z,applyState:'done'}:z))}catch(e){setVideos(x=>x.map(z=>z.id===v.id?{...z,applyState:'error',error:String(e)}:z))}}toast(`YouTube: применено ${ok}/${selected.length}`)}finally{setBusy(false)}}return <><div className="pageHeader"><div><small>EXISTING VIDEOS MANAGER</small><h1>Уже на YouTube</h1><p>Синхронизируй загруженные ролики, назначь метаданные и расписание, затем примени изменения пачкой.</p></div><div className="headerActions"><button d