isabled={busy} onClick={sync}>{busy?'РАБОТАЮ…':'↻ СИНХРОНИЗИРОВАТЬ'}</button><button className="primary" disabled={busy||!videos.some(v=>v.selected)} onClick={apply}>ПРИМЕНИТЬ ВЫБРАННЫЕ</button></div></div><input ref={file} hidden type="file" multiple accept=".json,.txt,.csv" onChange={e=>{void read(e.target.files);e.currentTarget.value=''}}/><div className="existingToolbar"><label>Канал<select value={channelId} onChange={e=>setChannelId(e.target.value)}>{channels.map(c=><option value={c.id} key={c.id}>{c.name}</option>)}</select></label><label>OAuth<select value={profileId} onChange={e=>setProfileId(e.target.value)}><option value="">— не подключён —</option>{profiles.map(p=><option value={p.id} key={p.id}>{p.channelTitle||p.channelId||p.id}</option>)}</select></label><label>Видео<input type="number" min="1" max="200" value={limit} onChange={e=>setLimit(Math.max(1,Math.min(200,+e.target.value||30)))}/></label><label>Порядок<select value={order} onChange={e=>setOrder(e.target.value as any)}><option value="oldest">старые → новые</option><option value="newest">новые → старые</option></select></label><label>Первая дата<input type="datetime-local" value={start} onChange={e=>setStart(e.target.value)}/></label><label>Каждые N дней<input type="number" min="1" max="30" value={cadence} onChange={e=>setCadence(+e.target.value||1)}/></label><button onClick={schedule}>РАССТАВИТЬ ДАТЫ</button><button onClick={()=>file.current?.click()}>+ МЕТАДАННЫЕ GPT</button></div>{meta.length>0&&<div className="publisherNotice"><b>Metadata Inbox</b><p>Импортировано {meta.length} записей. Проверь соответствие роликов перед применением.</p></div>}{videos.length===0?<div className="empty"><b>Видео ещё не синхронизированы</b><p>Выбери Lost Highway FM и нажми «Синхронизировать».</p></div>:<div className="existingList">{videos.map((v,i)=><div className={`existingCard ${v.applyState||''}`} key={v.id}><input type="checkbox" checked={v.selected} onChange={e=>setVideos(x=>x.map(z=>z.id===v.id?{...z,selected:e.target.checked}:z))}/>{v.thumbnail?<img src={v.thumbnail}/>:<div className="existingThumb">YT</div>}<div className="existingFields"><small>#{i+1} • {v.privacyStatus} • {v.id}</small><input value={v.title} maxLength={100} onChange={e=>setVideos(x=>x.map(z=>z.id===v.id?{...z,title:e.target.value}:z))}/><textarea value={v.description} onChange={e=>setVideos(x=>x.map(z=>z.id===v.id?{...z,description:e.target.value}:z))}/><input value={v.tags.join(', ')} onChange={e=>setVideos(x=>x.map(z=>z.id===v.id?{...z,tags:e.target.value.split(',').map(a=>a.trim()).filter(Boolean)}:z))}/></div><div className="existingSide"><input type="datetime-local" value={local(v.publishAt)} onChange={e=>setVideos(x=>x.map(z=>z.id===v.id?{...z,publishAt:e.target.value?new Date(e.target.value).toISOString():undefined}:z))}/><b>{v.applyState==='done'?'✓ Готово':v.applyState==='saving'?'Сохраняю…':v.applyState==='error'?'Ошибка':'К изменению'}</b>{v.error&&<small>{v.error}</small>}</div></div>)}</div>}</>}
''')

# App integration
must_replace(Path('src/App.tsx'),"import { bufferDays,deficit,formatNumber,priorityFor,requiredVideos } from './core';","import { bufferDays,deficit,formatNumber,priorityFor,requiredVideos } from './core';\nimport { ExistingVideos } from './ExistingVideos';")
must_replace(Path('src/App.tsx'),"{page:'analytics',icon:'⌁',label:'Аналитика'},{page:'publisher',icon:'↑',label:'Публикации'},{page:'settings',icon:'⚙',label:'Настройки'}","{page:'analytics',icon:'⌁',label:'Аналитика'},{page:'existing',icon:'◫',label:'Уже на YouTube'},{page:'publisher',icon:'↑',label:'Публикации'},{page:'settings',icon:'⚙',label:'Настройки'}")
must_replace(Path('src/App.tsx'),"page==='analytics'?<Analytics/>:page==='publisher'?<Publisher/>:<Settings license={license} setLicense={setLicense}/>","page==='analytics'?<Analytics/>:page==='existing'?<ExistingVideos/>:page==='publisher'?<Publisher/>:<Settings license={license} setLicense={setLicense}/>")
p=root/'src/App.tsx'; s=p.read_text().replace('VYRON 0.5.0 • macOS Apple Silicon','VYRON 0.5.1 • macOS Apple Silicon').replace('VYRON 0.5</span>','VYRON 0.5.1</span>'); p.write_text(s)

# styles
append_once(Path('src/styles.css'),'.existingToolbar',r'''
.existingToolbar{display:grid;grid-template-columns:1.3fr 1.3fr .55fr 1fr 1.25fr .7fr auto auto;gap:10px;align-items:end;background:rgba(10,22,35,.86);border:1px solid rgba(111,213,255,.13);padding:14px;border-radius:18px;margin-bottom:14px}.existingToolbar label{display:grid;gap:6px;font-size:11px;color:#7f91a8}.existingToolbar input,.existingToolbar select{min-width:0}.existingList{display:grid;gap:10px}.existingCard{display:grid;grid-template-columns:24px 150px minmax(320px,1fr) 220px;gap:14px;align-items:start;padding:14px;border:1px solid rgba(111,213,255,.12);border-radius:18px;background:rgba(8,18,30,.82)}.existingCard.done{border-color:rgba(94,255,186,.4)}.existingCard.error{border-color:rgba(255,92,118,.45)}.existingCard img,.existingThumb{width:150px;aspect-ratio:16/9;object-fit:cover;border-radius:12px;background:#091522;display:grid;place-items:center}.existingFields{display:grid;gap:7px}.existingFields textarea{min-height:72px}.existingSide{display:grid;gap:9px}.existingSide small{color:#ff7087;white-space:normal}@media(max-width:1250px){.existingToolbar{grid-template-columns:repeat(4,1fr)}.existingCard{grid-template-columns:24px 120px 1fr}.existingSide{grid-column:3}}
''')

# release notes
(root/'RELEASE_NOTES.md').write_text('''# VYRON 0.5.1 — Existing Videos Manager\n\n- Синхронизация уже загруженных роликов выбранного YouTube-канала.\n- Массовое редактирование title / description / tags.\n- Отложенная публикация: старт + интервал N дней.\n- Metadata Inbox из обычного ChatGPT (JSON/TXT/CSV).\n- Предпросмотр и выбор роликов перед изменением.\n- OAuth scope youtube.force-ssl; старый профиль нужно один раз переподключить.\n- Ошибка одного ролика не останавливает остальные.\n''')
print('VYRON 0.5.1 patch applied')
