упна: {update.version}</b><p>{update.body}</p>{stage&&<strong>{stage}</strong>}{progress!==null&&<div className="progress"><i style={{width:`${progress}%`}}/><span>{progress.toFixed(0)}%</span></div>}<button className="primary" onClick={installUpdate}>Установить и перезапустить</button></div>}{update?.error&&<div className="errorBox">Обновление не установлено. Текущая версия сохранена.<details><summary>Technical detail</summary>{update.error}</details></div>}</section><section className="settingsCard releaseHistoryCard"><small>ИСТОРИЯ ИЗМЕНЕНИЙ</small><h3>Что менялось по дням</h3><div className="releaseHistoryRows">{VYRON_RELEASE_HISTORY.map(x=><article key={x.version}><div><b>{x.date}</b><span>VYRON {x.version}</span></div><h4>{x.title}</h4><ul>{x.items.map((i,n)=><li key={n}>{i}</li>)}</ul></article>)}</div></section></div>}
  {tab==='license'&&<section className={`settingsCard licenseMasterCard ${license.valid?'activeLicense':'inactiveLicense'}`}><small>LICENSE</small><div className="licenseHero"><i>{license.valid?'✓':'!'}</i><div><h2>{license.valid?'VYRON YT PEISOV активирована':'Требуется активация'}</h2><p>{licenseName(license)}</p></div></div><div className="settingsInfoGrid"><span><small>Статус</small><b>{license.valid?'Активна':'Не активна'}</b></span><span><small>Тип</small><b>{licenseName(license)}</b></span><span><small>Срок</small><b>{license.expiresAt?new Date(license.expiresAt).toLocaleDateString('ru-RU'):'Без срока окончания'}</b></span>{license.maskedKey&&<span><small>Ключ</small><b>{license.maskedKey}</b></span>}</div><p>Основные локальные функции работают без постоянного подключения к интернету. Интернет необходим для YouTube/OAuth, публикации, проверки лицензии и обновлений.</p></section>}
  {tab==='about'&&<section className="settingsCard aboutMasterCard"><div className="aboutBrand"><div className="brandMark">▶</div><div><h2>{VYRON_PRODUCT_NAME}</h2><p>{VYRON_PRODUCT_SUBTITLE}</p></div></div><div className="aboutVersion">{installedVersion||'—'}</div><div className="settingsInfoGrid aboutGrid"><span><small>Версия</small><b>{installedVersion||'—'}</b></span><span><small>Сборка</small><b>{VYRON_BUILD_DATE==='development'?'Development':VYRON_BUILD_DATE}</b></span><span><small>Платформа</small><b>macOS • Apple Silicon M1+</b></span><span><small>Core</small><b>Rust + YouTube Data API</b></span><span><small>UI</small><b>Tauri 2 + React</b></span><span><small>Создатель</small><b>Kirill Peisov</b></span><span><small>Email</small><b>peisov.business@gmail.com</b></span></div></section>}
- {tab==='diagnostics'&&<div className="settingsStack"><section className="settingsCard"><div className="panelHead"><div><small>LOCAL ONLY</small><h3>Диагностика</h3><p>YouTube health/API checks намеренно не запускаются.</p></div><button className="primary" disabled={checking} onClick={runDiagnostics}>{checking?'Проверяю…':'Запустить проверку'}</button></div>{diag.length>0&&<div className="diagnosticGrid">{diag.map((x,i)=><div key={i} className={x.ok===false?'bad':x.ok?'good':''}><span><b>{x.label}</b><em>{x.status}</em></span>{x.detail&&<details><summary>Подробнее</summary><p>{x.detail}</p></details>}</div>)}</div>}</section><section className="settingsCard"><h3>Последние события</h3><div className="logs">{logs.length?logs.slice(0,60).map((l,i)=><div key={i} className={l.level}><small>{new Date(l.at).toLocaleString('ru-RU')}</small><span>{l.message}</span></div>):<p>Событий пока нет.</p>}</div></section></div>}</>
+ {tab==='diagnostics'&&<div className="settingsStack"><section className="settingsCard"><div className="panelHead"><div><small>LOCAL ONLY</small><h3>Диагностика</h3><p>YouTube health/API checks намеренно не запускаются.</p></div><button className="primary" disabled={checking} onClick={runDiagnostics}>{checking?'Проверяю…':'Запустить проверку'}</button></div>{diag.length>0&&<div className="diagnosticGrid">{diag.map((x,i)=><div key={i} className={x.ok===false?'bad':x.ok?'good':''}><span><b>{x.label}</b><em>{x.status}</em></span>{x.detail&&<details><summary>Подробнее</summary><p>{x.detail}</p></details>}</div>)}</div>}</section><section className="settingsCard"><div className="panelHead"><div><small>SECURE STORAGE</small><h3>macOS Keychain</h3><p>Проверка создаёт, читает и удаляет только временную тестовую запись VYRON. macOS может показать системный запрос пароля.</p></div><button className="settingsAction" disabled={keychainChecking} onClick={runKeychainDiagnostics}>{keychainChecking?'Проверяю Keychain…':'Проверить Keychain'}</button></div>{keychainDiag&&<div className={`diagnosticGrid ${keychainDiag.ok?'':'hasError'}`}><div className={keychainDiag.ok?'good':'bad'}><span><b>{keychainDiag.label}</b><em>{keychainDiag.status}</em></span>{keychainDiag.detail&&<details open={!keychainDiag.ok}><summary>Подробнее</summary><p>{keychainDiag.detail}</p></details>}</div></div>}<p className="note">Если macOS отклоняет пароль, VYRON больше не маскирует это общей ошибкой: локальные проекты продолжают сохраняться, а проблема Keychain показывается отдельно.</p></section><section className="settingsCard"><h3>Последние события</h3><div className="logs">{logs.length?logs.slice(0,60).map((l,i)=><div key={i} className={l.level}><small>{new Date(l.at