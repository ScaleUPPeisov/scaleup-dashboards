des('upload_session_expired')||s.includes('resumable session истек'))return{code:'UPLOAD_SESSION_EXPIRED',title:'Сессия YouTube истекла',message:'Старая resumable-сессия больше недействительна. Проверьте канал перед новым запуском, чтобы исключить дубль.',detail,retryable:false,action:'check-file'};
  if(s.includes('upload_file_changed'))return{code:'UPLOAD_FILE_CHANGED',title:'Видео изменилось после начала загрузки',message:'Размер исходного файла изменился. Продолжение старой сессии заблокировано для защиты от повреждения.',detail,retryable:false,action:'check-file'};
